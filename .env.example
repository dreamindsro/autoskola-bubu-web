# Canonical public origin used for same-origin validation and absolute links.
SITE_URL=https://www.autoskolabubu.cz

# Resend production configuration (server-only).
RESEND_API_KEY=
RESEND_FROM=Autoškola BuBu <objednavky@autoskolabubu.cz>
RESEND_REPLY_TO=strizkov@autoskolabubu.cz

# Local-only safe mode. Ignored when NODE_ENV=production.
ORDER_EMAIL_MODE=test

# Volitelný smoke test produkčního buildu proti lokálnímu Resend-kompatibilnímu mocku.
# URL musí být loopback a přepínač musí zůstat v produkčním prostředí vypnutý.
RESEND_BASE_URL=
RESEND_ALLOW_LOCAL_PROVIDER_MOCK=false
